@unpublished{WP3,
  title={The Positive Roots of Localism: How Place-Based Identity Drives the Preference for Hometown Candidates},
  author={Schulte-Cloos, Julia and Hegewald, Sven},
  abstract={Does the electoral advantage of local candidates reflect positive attachment to community or a defensive reaction to perceived neglect, and does it survive partisan polarization? Using a pre-registered conjoint experiment in Germany (N=2,500) that dynamically matches candidate profiles to respondents' municipalities and varies the availability of party cues, we document a robust hometown advantage that persists against polarized partisan signals and operates even across affective partisan divides. The preference is driven by positive place-based identity: long residence, local attachment, and rurality amplify the effect, while place-based resentment, anxiety about the local future, and populist support do not. We triangulate these findings with an observational analysis of 123,407 municipality-candidate observations across the 2021 and 2025 federal elections. Our results suggest that the geography-of-discontent framework, well-supported as an account of populist support and political distrust, does not extend to the demand for local representation in the way the literature has often assumed.}
}

