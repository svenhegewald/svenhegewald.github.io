@unpublished{WP5,
  title={Do Stringent Climate Policies Influence Rural Political Attitudes and Behavior? Evidence From the Nitrogen Crisis in the Netherlands},
  author={Hegewald, Sven and Bolet, Diane and Abou-Chadi, Tarik},
  abstract={This paper examines how stringent environmental policies can fuel rural discontent in the face of decarbonization. While much is known about how globalization, trade shocks, and automation generate political backlash among rural communities, the political implications of the green transition remain underexplored. We focus on the nitrogen crisis in the Netherlands, triggered by a 2019 court ruling that mandated strict environmental measures to reduce nitrogen emissions near protected habitats and disproportionately impacted rural agricultural areas. Using comprehensive municipality-level data, we analyse the ruling's impact on political backlash, measured through radical right support. Differences-in-differences analysis reveals that farming areas adversely affected by the ruling are more inclined to support radical right parties and oppose the government coalition, suggesting a greenlash. By generating patterns of radical right support similar to those seen with globalisation, trade shocks, and automation, the green transition underpins a new structural fault line with concerning political implications that exacerbate the urban-rural divide.}
}

@unpublished{WP6,
  title={Imagined Political Geographies: Political Misperceptions and Affective Polarization Along the Urban-Rural Divide},
  author={Hegewald, Sven and Schraff, Dominik},
  abstract={Recent research demonstrates a return of the urban--rural divide in many Western democracies. Besides documenting pronounced differences in political attitudes and behavior between urban and rural residents, this divide seems also accompanied by pronounced place-based affective polarization. Yet, despite this rapidly growing literature on the political consequences of the urban--rural divide, we still know comparatively little about the mechanisms through which these place-based antagonisms emerge. In this paper, we argue that the urban--rural divide increasingly follows a logic of group-based politics in which urban and rural places function as socio-political brands associated with distinct partisan allegiances. As a result, voters develop imagined political geographies that produce systematic misperceptions about the political preferences of urbanites and ruralites, particularly regarding support for Green and far-right parties. These misperceptions, in turn, are expected to reinforce place-based affective polarization. We test this argument by relying on data from two studies conducted in Germany. First, we show that urban and rural respondents systematically misperceive the voting behavior of their respective place-based out-groups. Moreover, stronger misperceptions are associated with higher levels of place-based affective polarization among rural respondents. Second, using a survey experiment, we demonstrate that correcting misperceptions about urban voting behavior significantly reduces place-based affective polarization among rural residents. Taken together, the findings suggest that affective polarization along the urban--rural divide is partly rooted in distorted perceptions of the political allegiances associated with urban and rural places.}
}

@unpublished{WP7,
  title={When the Springs Run Dry: Local Electoral Consequences of a German Spending Reform},
  author={Bayerlein, Michael and Haffert, Lukas and Hegewald, Sven and Schraff, Dominik},
  abstract={How do voters respond to localized austerity? We study the German Kurreform of 1996/97, which reduced rehabilitation benefits nationwide but created highly localized production-side shocks in spa municipalities (Kurorte) hosting rehabilitation facilities. We first establish the shock directly. Following the reform, spa municipalities lost hospitality-sector employment and fell onto a lower population trajectory than comparable non-spa municipalities. Combining municipality-level election data (GERDA) with administrative records of spa towns, we estimate event-study and OLS models to assess both short- and long-run political effects, taking all legally classified spa municipalities as our main treatment group and reserving more intensely exposed subsets for robustness. In the short run, spa municipalities punished the incumbent CDU/CSU–FDP coalition in the 1998 federal election and swung toward the mainstream opposition (SPD), with effects persisting and deepening well beyond a single electoral cycle. In the long run, the reform left a legacy of political withdrawal. Nearly three decades later, spa municipalities exhibit systematically lower electoral turnout. Robustness checks that vary the coding of local exposure, distinguish spa types, and isolate the hardest-hit towns all reproduce these patterns. Our findings highlight how politically attributable, localized austerity can generate persistent anti-incumbent voting and enduring electoral demobilization.}
}

